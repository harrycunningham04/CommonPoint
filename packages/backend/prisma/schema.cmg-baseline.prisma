model Admin {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique @db.VarChar(55)
  password   String?   @db.VarChar(255)
  avatar     String?   @db.Text
  name       String    @db.VarChar(50)
  surname    String    @db.VarChar(50)
  role       String
  access     Int       @default(1)
  phone      String?   @db.VarChar(20)
  address    String?   @db.VarChar(50)
  archived   Boolean   @default(false)
  archivedAt DateTime?

  contractorNotifications Boolean @default(false)
  clientNotifications     Boolean @default(false)
  bookingsNotifications   Boolean @default(false)

  forgot_password ForgotPasswordAdmin?
  Training        Training[]
  Contract        Contract[]

  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now()) @updatedAt
  Booking            Booking[]
  coupons            Coupon[]
  contractorInvoices ContractorInvoice[]
  clientInvoices     ClientInvoiceB2B[]
  offices            Office[]
  notifications      Notification[]
  AdminWidget        AdminWidget[]
  orderListColumns   OrderListColumns?
  editRequest        EditRequest[]

  @@map("admin")
}

model Widget {
  id   String     @id @default(uuid()) @db.Uuid
  name WidgetType
  type WidgetSize

  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now()) @updatedAt
  AdminWidget AdminWidget[]

  @@map("widget")
}

model AdminWidget {
  id       String @id @default(uuid()) @db.Uuid
  admin    Admin  @relation(fields: [adminId], references: [id])
  adminId  String @db.Uuid
  widget   Widget @relation(fields: [widgetId], references: [id])
  widgetId String @db.Uuid

  size        WidgetSize @default(SMALL)
  defaultSize WidgetSize @default(SMALL)

  isActive        Boolean @default(true)
  defaultIsActive Boolean @default(true)

  position        Int @default(0)
  defaultPosition Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("admin_widget")
}

model Contractor {
  id        String         @id @default(uuid()) @db.Uuid
  email     String         @unique @db.VarChar(55)
  archived  Boolean        @default(false)
  rating    Float          @default(0)
  active    Boolean        @default(true)
  radius    Int            @default(4)
  priority  Boolean        @default(false)
  name      String         @db.VarChar(50)
  surname   String         @db.VarChar(50)
  phone     String?        @db.VarChar(20)
  password  String?        @db.VarChar(255)
  avatar    String?        @db.Text
  address   String?        @db.VarChar(500)
  mark      ContractorMark @default(BRONZE)
  postCode  String?
  portfolio String?

  isAvailabilitySet Boolean @default(false) @map("is_availability_set")
  isProfileCreated  Boolean @default(false) @map("is_profile_created")

  isStipeSelected Boolean? @map("is_stripe_selected")
  stripeId        String?  @map("stripe_id")

  onSite Boolean @default(true)

  transportation ContractorTransportation @default(PUBLIC_TRANSPORTATION)

  forgot_password ForgotPasswordContractor?
  ChangeEmail     ChangeEmail?
  skills          ContractorSkills[]
  contracts       Contract[]
  regions         ContractorRegion[]
  availableDays   ContractorAvailableDay[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  paymentType PaymentType @default(STRIPE)

  reviews               Review[]
  Booking               Booking[]
  contractorDisputes    ContractorDispute[]
  contractorInvoices    ContractorInvoice[]
  notifications         Notification[]
  SpecificDocuments     SpecificDocuments[]
  ContractorTraining    ContractorTraining[]
  earningRates          EarningRate[]
  Statistic             Statistic[]
  locationId            String?                 @db.Uuid
  ContractorLocation    ContractorLocation?
  additionalProductType AdditionalProductType[]
  UserDevices           UserDevices[]
  ProductType           ProductType[]
  contractorPayouts     ContractorPayout[]
  adjustmentFees        AdjustmentFee[]
  equipments            Equipment[]
  vacations             Vacation[]

  @@map("contractor")
}

model ContractorPayout {
  id String @id @default(uuid()) @db.Uuid

  contractorId String     @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  amount     Int
  transferId String @map("transfer_id")

  payoutId String? @map("payout_id")

  status ContractorPayoutStatus @default(PENDING)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model SpecificDocuments {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(255)
  url  String @db.VarChar(200)

  expiredAt DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  type SpecificDocumentType @default(CERTIFICATE)

  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("specific_documents")
}

model ContractorAvailableDay {
  id        String   @id @default(uuid()) @db.Uuid
  date_time DateTime @default(now())
  from      Int[]
  to        Int[]

  contractor    Contractor @relation(fields: [contractor_id], references: [id], onDelete: Cascade)
  contractor_id String     @db.Uuid
}

model ContractorRegion {
  contractorId String     @db.Uuid
  regionId     String     @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  region       Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)

  isHome Boolean @default(false) @map("is_home")

  @@id([contractorId, regionId])
}

enum VacationType {
  VACATION
  SICK_LEAVE
  OTHER
}

model Vacation {
  id           String     @id @default(uuid()) @db.Uuid
  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  vacationType VacationType @default(VACATION) @map("vacation_type")
  reason       String?      @map("reason")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("vacation")
}

model Region {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)

  contractorRegions ContractorRegion[]
  Booking           Booking[]
}

model Contract {
  id   String  @id @default(uuid()) @db.Uuid
  name String  @db.VarChar(100)
  file String?

  start_date DateTime @default(now())
  end_date   DateTime @default(now())

  contractor    Contractor @relation(fields: [contractor_id], references: [id], onDelete: Cascade)
  contractor_id String     @db.Uuid

  admin_id String @db.Uuid
  admin    Admin  @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

model ContractorSkills {
  contractor    Contractor @relation(fields: [contractor_id], references: [id], onDelete: Cascade)
  contractor_id String     @db.Uuid

  skill    Skills @relation(fields: [skill_id], references: [id], onDelete: Cascade)
  skill_id String @db.Uuid

  confirmed Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@id([contractor_id, skill_id])
  @@map("contractor_skills")
}

model Skills {
  id String @id @default(uuid()) @db.Uuid

  name ContractorSkillNama
  icon String

  created_at        DateTime            @default(now())
  updated_at        DateTime            @default(now()) @updatedAt
  ContractorSkills  ContractorSkills[]
  productSkills     ProductSkills[]
  productTypeSkills ProductTypeSkills[]
}

model ForgotPasswordContractor {
  id String @id @default(uuid()) @db.Uuid

  contractor_id String     @unique @db.Uuid
  contractor    Contractor @relation(fields: [contractor_id], references: [id], onDelete: Cascade)

  updated_at DateTime @default(now()) @updatedAt

  @@index([contractor_id])
  @@map("forgot_password_contractor")
}

model ForgotPasswordClient {
  id String @id @default(uuid()) @db.Uuid

  b2cClient_id String?     @unique @db.Uuid
  b2cClient    B2CClients? @relation(fields: [b2cClient_id], references: [id], onDelete: Cascade)

  b2bClient_id String?     @unique @db.Uuid
  b2bClient    B2BClients? @relation(fields: [b2bClient_id], references: [id], onDelete: Cascade)

  updated_at DateTime @default(now()) @updatedAt

  @@index([b2cClient_id])
  @@index([b2bClient_id])
  @@map("forgot_password_client")
}

model ForgotPasswordAdmin {
  id String @id @default(uuid()) @db.Uuid

  admin_id String @unique @db.Uuid
  admin    Admin  @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  updated_at DateTime @default(now()) @updatedAt

  @@index([admin_id])
  @@map("forgot_password_admin")
}

model ChangeEmail {
  id Int @id @default(autoincrement())

  contractor_id String     @unique @db.Uuid
  contractor    Contractor @relation(fields: [contractor_id], references: [id], onDelete: Cascade)

  oldEmailCode String @db.Text
  newEmailCode String @db.Text

  newEmail String @db.VarChar(50)

  updated_at DateTime @default(now()) @updatedAt

  @@index([contractor_id])
  @@map("change_email")
}

model ContractorListColumns {
  id Int @id @default(autoincrement())

  type    Boolean @default(true)
  skills  Boolean @default(true)
  mark    Boolean @default(true)
  status  Boolean @default(true)
  address Boolean @default(true)
  rating  Boolean @default(true)

  @@map("contractor_list_columns")
}

model ContractorStatisticsColums {
  id              Int     @id @default(autoincrement())
  photoSLA        Boolean @default(true)
  sketchSLA       Boolean @default(true)
  contentSLA      Boolean @default(true)
  floorplanSLA    Boolean @default(true)
  earning         Boolean @default(true)
  avgComplRate    Boolean @default(true)
  avgPhotoCapture Boolean @default(true)
  avgJobPerWeek   Boolean @default(true)
  totalJobsDone   Boolean @default(true)
  howOftenOnTime  Boolean @default(true)

  @@map("cotractor_statistics_columns")
}

model Office {
  id                  String       @id @default(uuid()) @db.Uuid
  title               String       @db.VarChar(150)
  name                String       @db.VarChar(100)
  surname             String       @db.VarChar(100)
  numberOfWorkers     Int
  phone_number        String       @default("") @db.VarChar(30)
  email               String       @default("") @db.VarChar(50)
  address_coordinates String?      @db.VarChar(200)
  address             String       @default("") @db.VarChar(200)
  billing_address     String       @default("") @db.VarChar(200)
  officeStatus        ClientStatus @default(NEW)
  status              Boolean      @default(false)

  admin_id String @db.Uuid
  admin    Admin  @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  b2BClientsId String?     @db.Uuid
  b2BClients   B2BClients? @relation(fields: [b2BClientsId], references: [id])

  subbrandId String?   @db.Uuid
  Subbrand   Subbrand? @relation(fields: [subbrandId], references: [id])

  propertyTypes    PropertyType[]
  officeType       OfficeType       @default(RESIDENTIAL)
  officeClientType OfficeClientType @default(SALES)

  ClientInvoices ClientInvoiceB2B[]

  Booking                 Booking[]
  ProductTypeSpecialPrice ProductTypeSpecialPrice[]

  paymentPreferences PaymentPreference @default(INVOICES)
  workers            WorkerOnOffice[]

  PackageTargets      PackageTargets[]
  BookingGroup        BookingGroup[]
  officePreference    OfficePreference[]
  officeHiddenProducts OfficeHiddenProduct[]
}

model OfficeHiddenProduct {
  id        String @id @default(uuid()) @db.Uuid
  officeId  String @db.Uuid @map("office_id")
  productId String @db.Uuid @map("product_id")

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([officeId, productId])
}

model Worker {
  id        String @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String @db.VarChar(100)
  password  String @default("temporary_password") @db.VarChar(255)

  phoneNumber              String                        @db.VarChar(30)
  role                     String                        @db.VarChar(50)
  notification_preferences NotificationUserPreferences[]

  created_at   DateTime         @default(now())
  updated_at   DateTime         @default(now()) @updatedAt
  offices      WorkerOnOffice[]
  BookingGroup BookingGroup[]
  Booking      Booking[]
  Notification Notification[]
}

model WorkerOnOffice {
  worker_id String @db.Uuid
  office_id String @db.Uuid
  worker    Worker @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  office    Office @relation(fields: [office_id], references: [id], onDelete: Cascade)

  assigned_at DateTime @default(now())

  @@id([worker_id, office_id])
}

model ClientDispute {
  id String @id @default(uuid()) @db.Uuid

  theme       DisputeTheme          @default(BOOKING)
  status      DisputeStatus         @default(IN_PROGRESS)
  category    ClientDisputeCategory @default(BOOKING_ISSUE)
  description String                @default("") @db.VarChar(1000)
  created_at  DateTime              @default(now())
  updated_at  DateTime              @default(now())
  archived    Boolean               @default(false)

  b2CClientId String?     @db.Uuid
  b2CClient   B2CClients? @relation(fields: [b2CClientId], references: [id])
  b2BClientId String?     @db.Uuid
  b2BClient   B2BClients? @relation(fields: [b2BClientId], references: [id])

  bookingGroupId String?       @db.Uuid
  bookingGroup   BookingGroup? @relation(fields: [bookingGroupId], references: [id], onDelete: Cascade)

  clientInvoiceB2BId String?              @db.Uuid
  clientInvoiceB2B   ClientInvoiceB2B?    @relation(fields: [clientInvoiceB2BId], references: [id], onDelete: Cascade)
  editRequests       EditRequest[]
  editRequestSession EditRequestSession[]
}

model ClientInvoiceB2B {
  id String @id @default(uuid()) @db.Uuid

  sum             String        @default("") @db.VarChar(50)
  billing_address String        @default("") @db.VarChar(200)
  status          InvoiceStatus @default(AWAITING_PAYMENT)
  payment_method  PaymentMethod @default(BANK_TRANSFER)
  file            String?

  stripeInvoiceId String? @map("stripe_invoice_id") @db.VarChar(100)
  xeroInvoiceId   String? @map("xero_invoice_id") @db.VarChar(100)

  admin_id String @db.Uuid
  admin    Admin  @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  officeId String @db.Uuid
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  clientDisputes ClientDispute[]

  bookingGroups BookingGroup[] @relation("ClientInvoiceB2BToBookingGroups")

  created_at DateTime @default(now())
}

model ContractorDispute {
  id String @id @default(uuid()) @db.Uuid

  theme       DisputeTheme              @default(BOOKING)
  status      DisputeStatus             @default(IN_PROGRESS)
  category    ContractorDisputeCategory @default(CAPTURE_ISSUE)
  description String                    @default("") @db.VarChar(1000)
  created_at  DateTime                  @default(now())
  updated_at  DateTime                  @default(now())
  archived    Boolean                   @default(false)

  address String @default("") @db.VarChar(200)
  // address from booking for easier grouping

  contractor_id String     @db.Uuid
  contractor    Contractor @relation(fields: [contractor_id], references: [id], onDelete: Cascade)

  report Report?

  contractorInvoiceId String?            @db.Uuid
  contractorInvoice   ContractorInvoice? @relation(fields: [contractorInvoiceId], references: [id], onDelete: Cascade)

  bookingId String  @db.Uuid
  Booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum ReportType {
  photo
  floorplan
  video
  drone
  epc
}

model Report {
  id String @id @default(uuid()) @db.Uuid

  type      ReportType
  location  String     @db.VarChar(100)
  problem   String     @db.VarChar(100)
  solution  String     @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at")

  isCancellation Boolean @default(false) @map("is_cancellation")

  attachments String[]

  contractorDispute   ContractorDispute @relation(fields: [contractorDisputeId], references: [id])
