model ContractorLocation {
  id        String  @id @default(uuid()) @db.Uuid
  placeId   String? @map("place_id") @db.VarChar(256)
  latitude  Float
  longitude Float

  contractorId String     @unique @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model Location {
  id        String  @id @default(uuid()) @db.Uuid
  placeId   String? @map("place_id") @db.VarChar(256)
  latitude  Float
  longitude Float

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String  @unique @map("booking_id") @db.Uuid
}

model BookingStageHistory {
  id        String       @id @default(uuid()) @db.Uuid
  bookingId String       @db.Uuid
  stage     BookingStage
  timestamp DateTime     @default(now())
  booking   Booking      @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model RawMaterial {
  id           String              @id @default(uuid()) @db.Uuid
  url          String              @db.VarChar(200)
  thumbnailUrl String?             @db.VarChar(200)
  contentType  MaterialTypeContent @default(PHOTOS)
  fileSize     Int?                @db.Integer
  rawType      MaterialRawType     @default(RAW)

  groupId Int? @db.Integer

  takenAt DateTime? @db.Timestamp(6)

  name            String            @db.VarChar(100)
  bookingId       String            @db.Uuid
  Booking         Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  RawMaterialVote RawMaterialVote[]

  @@index([bookingId])
}

model EditedMaterial {
  id           String              @id @default(uuid()) @db.Uuid
  url          String              @db.VarChar(400)
  thumbnailUrl String?             @db.VarChar(400)
  contentType  MaterialTypeContent @default(PHOTOS)
  fileSize     Int?                @db.Integer
  mimetype     String?

  name               String               @db.VarChar(400)
  isHeroShoot        Boolean              @default(false)
  bookingId          String               @db.Uuid
  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  EditedMaterialVote EditedMaterialVote[]

  isAdminUploaded Boolean @default(false)
  isCorrection    Boolean @default(false)

  clientPhotoId String?                 @unique @db.Uuid
  clientPhoto   BookingCGIClientPhotos? @relation(fields: [clientPhotoId], references: [id], onDelete: Cascade)
  editRequest   EditRequest?

  @@index([bookingId])
}

model EditRequest {
  id              String          @id @default(uuid()) @db.Uuid
  requestedChange String          @default("")
  type            EditRequestType @default(SINGLE)

  editedMaterialId String?         @unique @db.Uuid
  editedMaterial   EditedMaterial? @relation(fields: [editedMaterialId], references: [id], onDelete: Cascade)

  bookingId   String?              @db.Uuid
  booking     Booking?             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  contentType MaterialTypeContent?

  status EditRequestStatus @default(ACTIVE)

  editRequestMaterials EditRequestMaterial[]

  adminId String? @db.Uuid
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  session   EditRequestSession? @relation(fields: [sessionId], references: [id])
  sessionId String?             @db.Uuid

  orderLineId String?         @db.Uuid
  orderLine   ESoftOrderLine? @relation(fields: [orderLineId], references: [id])

  clientDisputeId String?        @db.Uuid
  clientDispute   ClientDispute? @relation(fields: [clientDisputeId], references: [id], onDelete: Cascade)

  clientUploadedPhotoUrl String? @db.VarChar(2048)

  createdAt DateTime @default(now())
}

model EditRequestSession {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  clientDisputeId String?        @db.Uuid
  clientDispute   ClientDispute? @relation(fields: [clientDisputeId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  editRequests EditRequest[]
}

model EditRequestMaterial {
  id           String              @id @default(uuid()) @db.Uuid
  name         String              @db.VarChar(100)
  url          String              @db.VarChar(200)
  thumbnailUrl String?             @db.VarChar(200)
  contentType  MaterialTypeContent @default(PHOTOS)
  fileSize     Int?                @db.Integer
  mimetype     String?

  editRequestId String      @db.Uuid
  editRequest   EditRequest @relation(fields: [editRequestId], references: [id], onDelete: Cascade)
}

model RawMaterialVote {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  materialId  String      @db.Uuid
  voteType    VoteType
  createdAt   DateTime    @default(now())
  rawMaterial RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
}

model EditedMaterialVote {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  materialId     String         @db.Uuid
  voteType       VoteType
  createdAt      DateTime       @default(now())
  editedMaterial EditedMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
}

model BookingListColumns {
  id Int @id @default(autoincrement())

  priority   Boolean @default(true)
  dateTime   Boolean @default(true)
  address    Boolean @default(true)
  contractor Boolean @default(true)
  stage      Boolean @default(true)
}

model OrderListColumns {
  id Int @id @default(autoincrement())

  priority   Boolean @default(true)
  dateTime   Boolean @default(true)
  contractor Boolean @default(true)
  stage      Boolean @default(true)

  adminId String? @unique @db.Uuid
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model InvoiceSentToStripe {
  id String @id @default(uuid()) @db.Uuid

  status StripeInvoiceStatus @default(SENT)

  stripeInvoiceId String @map("stripe_invoice_id") @db.VarChar(100)

  clientId String     @map("client_id") @db.Uuid
  client   B2BClients @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("invoice_sent_to_stripe")
}

enum StatisticType {
  BOOKING_RUNNING_LATE
  BOOKING_RUNNING_ON_TIME
  CONTRACTOR_INVOICE_CREATED
  COMPLETED_BOOKING_DURATION
  COMPLETED_BOOKING_PHOTO_COUNT
  BOOKING_REVIEW_RATING
  BOOKING_DONE
  BOOKING_DONE_WITH_FLOORPLAN
  BOOKING_DONE_WITHOUT_FLOORPLAN
  BOOKING_FOORPLAN_ACCURACY
  BOOKING_PHOTO_SLA
  BOOKING_PHOTO_SLA_FAILED
  CONTRACTOR_EXPECTED_EARNING
}

model Statistic {
  id String @id @default(uuid()) @db.Uuid

  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id])

  type StatisticType

  payload Json @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, contractorId, createdAt])
  @@index([type, contractorId])
  @@map("statistic")
}

enum ESoftOrderStatus {
  PENDING
  COMPLETED
  FAILED
  CREATED
  CORRECTION_CREATED
}

enum ESoftOrderType {
  ORDER
  ORDER_CORRECTION
}

model ESoftOrder {
  id              String           @id @default(uuid()) @db.Uuid
  orderId         Int              @unique
  reference       String           @unique @db.Uuid
  orderLines      ESoftOrderLine[]
  status          ESoftOrderStatus @default(PENDING)
  type            ESoftOrderType   @default(ORDER)
  rootOrderId     String?          @db.Uuid
  rootOrder       ESoftOrder?      @relation("CorrectionOrder", fields: [rootOrderId], references: [id], onDelete: Cascade)
  correctionOrder ESoftOrder[]     @relation("CorrectionOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

enum ESoftProductTypes {
  PHOTO
  VIDEO
}

model ESoftOrderLine {
  id String @id @default(uuid()) @db.Uuid

  type               ESoftProductTypes
  orderLineId        Int               @unique
  quantity           Int?
  externalId         String?
  productName        String?
  autoMarkBatchReady Boolean?

  orderId String     @db.Uuid
  order   ESoftOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  httpFiles   ESoftHttpFile[]
  editRequest EditRequest[]

  @@index([orderId])
}

model ESoftHttpFile {
  id String @id @default(uuid()) @db.Uuid

  url  String
  size Int
  name String

  orderLineId String         @db.Uuid
  orderLine   ESoftOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
}

model UserDevices {
  id          String    @id @default(uuid())
  oneSignalId String?   @unique @db.VarChar(255)
  muted       Boolean   @default(false)
  muteExpiry  DateTime? @db.Timestamp

  ownerId String     @db.Uuid
  owner   Contractor @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("user_devices")
}

model DraftBooking {
  id String @id @default(uuid()) @db.Uuid

  info Json @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("draft_booking")
}

model AdjustmentFee {
  id String @id @default(uuid()) @db.Uuid

  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  bookingId String  @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status AdjustmentFeeStatus @default(PENDING)

  type   AdjustmentFeeType
  amount Float

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("adjustment_fee")
}

model Equipment {
  id String @id @default(uuid()) @db.Uuid

  equipmentType EquipmentType

  brand String
  model String

  createdAt DateTime @default(now()) @map("created_at")

  contractorId String     @map("contractor_id") @db.Uuid
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("equipment")
}

model RouteCache {
  id String @id @default(uuid()) @db.Uuid

  fromLat Float
  fromLng Float
  toLat   Float
  toLng   Float

  transportMode ContractorTransportation @default(CAR)

  distance Float
  duration Float

  polyline String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([fromLat, fromLng, toLat, toLng, transportMode])
  @@map("route_cache")
}

model BookingRoute {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  duration     Float
  distance     Float
  isOverridden Boolean @default(false)

  polyline String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("booking_route")
}

model XeroConnection {
  id           String @id @default(uuid()) @db.Uuid
  accessToken  String @db.VarChar(2048)
  refreshToken String @db.VarChar(2048)

  tenantId String @unique

  expiresAt DateTime @db.Timestamp

  idToken String? @db.VarChar(2048)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}
