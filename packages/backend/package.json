{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "db:reset:dev": "yarn prisma migrate reset --preview-feature",
    "db:migrate:dev": "yarn prisma migrate dev --preview-feature",
    "db:deploy:dev": "yarn prisma migrate deploy --preview-feature",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --collect-coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@nestjs/cli": "10.3.0",
    "@nestjs/common": "10.3.0",
    "@nestjs/config": "3.1.1",
    "@nestjs/core": "10.3.0",
    "@nestjs/platform-express": "10.3.0",
    "@nestjs/schedule": "4.0.0",
    "@nestjs/schematics": "10.1.0",
    "@nestjs/swagger": "7.2.0",
    "@prisma/client": "5.8.1",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "axios": "1.6.5",
    "bcrypt": "5.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.6",
    "date-fns": "^3.6.0",
    "dotenv": "16.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "9.0.2",
    "moment-timezone": "^0.5.48",
    "nestjs-prisma": "0.22.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "papaparse": "^5.4.1",
    "prisma": "5.8.1",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "sharp": "0.32.6",
    "stripe": "^16.4.0",
    "swagger-ui-express": "5.0.0",
    "uuid": "9.0.1",
    "xero-node": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "10.3.0",
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.6",
    "@types/express": "4.17.21",
    "@types/fluent-ffmpeg": "^2.1.25",
    "@types/jest": "29.5.11",
    "@types/jsonwebtoken": "9.0.5",
    "@types/moment-timezone": "^0.5.30",
    "@types/multer": "1.4.11",
    "@types/node": "20.11.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/nodemailer-express-handlebars": "^4.0.5",
    "@types/papaparse": "^5.3.14",
    "@types/supertest": "2.0.16",
    "@types/uuid": "9.0.7",
    "@typescript-eslint/eslint-plugin": "6.19.0",
    "@typescript-eslint/parser": "6.19.0",
    "envalid": "8.0.0",
    "eslint": "8.56.0",
    "jest": "29.7.0",
    "lint-staged": "15.2.0",
    "node-mocks-http": "1.14.1",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "ts-jest": "29.1.1",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
