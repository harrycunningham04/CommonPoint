{
  "name": "commonpoint",
  "version": "0.1.0",
  "description": "Common Point marketplace backend foundation",
  "main": "index.js",
  "private": true,
  "scripts": {
    "postinstall": "husky install",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "backend:dev": "yarn workspace backend start:dev",
    "backend:lint": "yarn workspace backend lint",
    "backend:build": "yarn workspace backend build",
    "backend:test": "yarn workspace backend test",
    "start": "yarn backend:dev",
    "prepare": "husky install"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "husky": "^8.0.0",
    "pinst": "^3.0.0",
    "typescript": "^5.1.6",
    "typescript-node": "^0.1.3"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.2.0",
    "concurrently": "^8.0.1"
  },
  "resolutions": {
    ".prisma": "link:node-modules/.prisma"
  },
  "packageManager": "yarn@4.5.0"
}